# The API (NestJS), with the /api/v1 prefix
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public address of this site (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Push notifications: Firebase console → Project settings → General → Your apps (Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Project settings → Cloud Messaging → Web Push certificates → Key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Production: where the NestJS API really runs. When set, the browser calls
# the API through this site at /api/v1 (first-party cookies) and
# NEXT_PUBLIC_API_URL should be https://<this-site>/api/v1.
API_ORIGIN=
