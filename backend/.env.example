NODE_ENV=development
PORT=4000
APP_NAME="Store"
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (docker-compose)
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public"

# Upstash Redis (REST)
# Local dev: docker-compose "redis-http" service emulates Upstash on port 8079.
# Production: copy REST URL + token from https://console.upstash.com
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN="local_dev_token"

# JWT (generate per environment: openssl rand -hex 48)
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="7d"

# HMAC secret for hashing OTP codes (openssl rand -hex 32)
OTP_SECRET="change-me"

# SMTP (Nodemailer). Leave SMTP_HOST empty in dev to log emails/OTPs to the console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Store <no-reply@example.com>"

# Link guest orders by phone on verification. Off by default: phone numbers are
# not verified, so enabling this lets anyone claim orders placed with that phone.
CLAIM_GUEST_ORDERS_BY_PHONE="false"


# AES-256-GCM key for encrypting secrets at rest (openssl rand -hex 32)
ENCRYPTION_KEY="change-me"

# File storage: local | blob
STORAGE_DRIVER="local"
# Local driver: keep uploads OUTSIDE the app folder on the VPS so deploys never
# delete them (e.g. /var/www/store-uploads). Default: ./uploads
UPLOAD_DIR="uploads"
# URL prefix stored with each image. Absolute in dev so the Next.js app on
# another port can load it; on the VPS e.g. https://api.example.com/uploads
# (or a path nginx serves straight from UPLOAD_DIR). Default: /uploads
UPLOADS_PUBLIC_URL="http://localhost:4000/uploads"
# Vercel Blob (STORAGE_DRIVER=blob)
BLOB_READ_WRITE_TOKEN=""

# Push notifications (Firebase Cloud Messaging). Firebase console → Project settings →
# Service accounts → Generate new private key; copy three fields from that JSON.
# Keep the private key on one line with literal \n (wrap it in double quotes).
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Seeders (insert-only). Run on startup when "true", or on demand: npm run seed
SEED_CATALOG="false"
SEED_SUPER_ADMIN="false"
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Public base URL of this API (Paymob webhook + browser callback point here)
APP_BACKEND_URL="http://localhost:4000"

# Paymob (Unified Intention API) — https://accept.paymob.com/portal2/en/settings
# Leave empty in dev: card/wallet checkout then returns a "payment unavailable" hint.
PAYMOB_SECRET_KEY=""
PAYMOB_PUBLIC_KEY=""
# Legacy API key (not needed by the intention flow; kept for older endpoints)
PAYMOB_API_KEY=""
# HMAC secret used to verify webhooks and callbacks (required to accept payments)
PAYMOB_HMAC_SECRET=""
PAYMOB_CARD_INTEGRATION_ID=""
PAYMOB_WALLET_INTEGRATION_ID=""

# AI (OpenAI-compatible chat completions). Empty key = built-in data-based answers, no external calls.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# WhatsApp Cloud API (Meta). Empty token = order updates are only logged.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Approved message template for order updates (params: order number, status)
WHATSAPP_ORDER_TEMPLATE="order_status_update"
WHATSAPP_TEMPLATE_LANG="ar"
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Background jobs (abandoned carts, unpaid order expiry, back-in-stock). true in tests.
DISABLE_CRON="false"
